# Production Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============= DATABASE CONFIGURATION =============
# MongoDB Connection String (REQUIRED)
# For Railway MongoDB Plugin: Use the MONGO_URL from Railway variables
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGODB_URI=your-mongodb-connection-string-here

# Database Name
DATABASE_NAME=universe_ai

# ============= API KEYS =============
# OpenRouter API Key (OPTIONAL - users provide their own in app settings)
# Only set this if you want a default fallback key
OPENROUTER_API_KEY=

# Unsplash API Key (OPTIONAL - for educational image generation)
UNSPLASH_ACCESS_KEY=

# ============= APPLICATION SETTINGS =============
# Flask/Backend Configuration
SECRET_KEY=your-super-secret-random-string-change-this-in-production
DEBUG=False
PORT=5000

# Session Configuration
SESSION_EXPIRY_HOURS=168

# ============= SECURITY =============
# JWT Secret for authentication (REQUIRED - generate a strong random string)
JWT_SECRET=your-jwt-secret-key-different-from-secret-key

# CORS allowed origins (comma-separated)
# For Railway deployment, add your Railway domain
# Example: https://yourapp.up.railway.app,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# ============= OAUTH (OPTIONAL) =============
# Google Client ID (only if using Google Sign-In)
GOOGLE_CLIENT_ID=
