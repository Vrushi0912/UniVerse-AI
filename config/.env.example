# UniVerse AI - Environment Configuration
# Copy this file to .env and fill in your credentials

# ============= DATABASE CONFIGURATION =============
# MongoDB Connection String
# For local MongoDB: mongodb://localhost:27017/universe_ai
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/universe_ai
# For MongoDB Compass: Use mongodb://localhost:27017 to connect, database will be created automatically
MONGO_URI=mongodb://localhost:27017/universe_ai

# Database Name (optional if included in MONGO_URI)
DATABASE_NAME=universe_ai

# Connection Pool Configuration (optional, defaults are shown)
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=10
MONGO_TIMEOUT_MS=10000

# ============= API KEYS =============
# Gemini API Key (for AI content generation)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# OpenRouter API Key (for AI features)
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# Unsplash API Key (for educational image generation)
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# ============= APPLICATION SETTINGS =============
# Flask/Backend Configuration
SECRET_KEY=your-secret-key-for-sessions
DEBUG=False
PORT=5000

# Session Configuration
SESSION_EXPIRY_HOURS=24

# ============= SECURITY =============
# JWT Secret for authentication
JWT_SECRET=/Bz6GaFjYU6+GWSK2DXFR7WrQUkBeKvPBGe+weNet+U=

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
