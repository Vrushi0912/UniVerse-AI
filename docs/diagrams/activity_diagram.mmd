graph TD
    Start((Start)) --> Login[User Login]
    Login --> Auth{Valid?}
    Auth -- No --> Login
    Auth -- Yes --> Enter[Enter Prompt]
    Enter --> Send[Send to Backend]
    Send --> Process[Process with Agents]
    Process --> Generate[Generate Output]
    Generate --> SaveQ{Save?}
    SaveQ -- Yes --> Save[Save to Library]
    Save --> Display[Display Result]
    SaveQ -- No --> Display
    Display --> End((End))

    style Start fill:#000,stroke:#333,stroke-width:2px,color:#fff
    style End fill:#000,stroke:#333,stroke-width:2px,double,color:#fff
    style Auth fill:#ff9,stroke:#333,stroke-width:1px
    style SaveQ fill:#ff9,stroke:#333,stroke-width:1px
